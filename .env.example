# Copy this file to .env and fill in real values. .env is gitignored --
# .env.example is the only one that should ever be committed.

# A GitHub personal access token with at least read access to pull requests
# on the repo you're testing against. Create one at:
# https://github.com/settings/tokens
GITHUB_TOKEN=

# Discord or Slack incoming webhook URL. Leave blank to just print
# notifications to the console instead of sending them anywhere.
MERGEWATCH_WEBHOOK_URL=
